<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="2dp" android:color="@color/accent_dark" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="2dp" android:color="@color/bg_card" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
